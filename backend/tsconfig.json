{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "shared", "script", "vite.config.ts", "tailwind.config.ts"]
}
